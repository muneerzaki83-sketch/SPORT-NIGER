# GEMINI_API_KEY: Unused in this project.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# FOOTBALL_DATA_API_KEY: Optional licensed football scores API key (e.g. football-data.org v4).
# Configure via the Secrets panel in AI Studio. When left blank/default, SPORT NIGER uses
# manual/staff-managed match records in Firestore without generating fake live scores.
FOOTBALL_DATA_API_KEY=MY_FOOTBALL_DATA_API_KEY
